 static void
+mtk_wed_v3_1_set_wpdma(struct mtk_wed_device *dev)
+{
+	int i;
+
+	/* Tx data ring */
+	wed_w32(dev, MTK_WED_WPDMA_CFG_TX0_CIDX,
+		dev->wlan.wpdma_tx[0] + MTK_WED_RING_OFS_CPU_IDX);
