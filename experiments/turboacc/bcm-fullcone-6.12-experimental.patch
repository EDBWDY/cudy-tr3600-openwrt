+/****************************************************************************/
+static inline int find_exp(__be32 ip, __be16 port, struct nf_conn *ct)
+{
+       struct nf_conntrack_expect *i;
+       unsigned int h;
+       bool found = false;
+
+       /* Restricted expectations have a non-wildcard source address, so
+        * reserve the external port independently of that source filter. */
+       rcu_read_lock();
+       for (h = 0; h < nf_ct_expect_hsize && !found; h++) {
+               hlist_for_each_entry_rcu(i, &nf_ct_expect_hash[h], hnode) {
+                       if (nf_ct_net(i->master) == nf_ct_net(ct) &&
+                           nf_ct_zone_equal(i->master, nf_ct_zone(ct),
+                                            IP_CT_DIR_ORIGINAL) &&
+                           i->tuple.dst.protonum == nf_ct_protonum(ct) &&
+                           i->tuple.dst.u3.ip == ip &&
+                           i->tuple.dst.u.all == port) {
+                               found = true;
+                               break;
+                       }
+               }
+       }
+       rcu_read_unlock();
+       return found;
+}
+
+/****************************************************************************/
+static inline struct nf_conntrack_expect *find_fullcone_exp(struct nf_conn *ct,
+                                                            __be32 newsrc)
+{
+       struct nf_conntrack_tuple * tp =
+               &ct->tuplehash[IP_CT_DIR_ORIGINAL].tuple;
+       struct nf_conntrack_expect * exp = NULL;
+       struct nf_conntrack_expect * i;
+       unsigned int h;
+
+       rcu_read_lock();
+       for (h = 0; h < nf_ct_expect_hsize; h++) {
+               hlist_for_each_entry_rcu(i, &nf_ct_expect_hash[h], hnode) {
+                       if (nf_ct_net(i->master) == nf_ct_net(ct) &&
+                           nf_ct_zone_equal(i->master, nf_ct_zone(ct),
+                                            IP_CT_DIR_ORIGINAL) &&
+                           i->tuple.dst.u3.ip == newsrc &&
+                           nf_inet_addr_cmp(&i->saved_addr, &tp->src.u3) &&
+                           i->saved_proto.all == tp->src.u.all &&
+                           i->tuple.dst.protonum == tp->dst.protonum &&
+                           i->expectfn == bcm_nat_expect &&
+                           i->tuple.src.u.all == 0) {
+                               exp = i;
+                               break;
+                       }
+               }
+       }
+       rcu_read_unlock();
+
+       return exp;
+}
