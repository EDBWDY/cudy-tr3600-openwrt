+/* Only our TCP cone masters and their RELATED children are removed.
+ * Ordinary forwarded TCP, local management, and other helpers are retained. */
+static bool nf_ct_is_tcp_cone(const struct nf_conn *ct)
+{
+    const struct nf_conn_help *help = nfct_help(ct);
+    const struct nf_conntrack_helper *helper;
+    bool found = false;
+
+    if (!help)
+        return false;
+    rcu_read_lock();
+    helper = rcu_dereference(help->helper);
+    if (helper && !strcmp(helper->name, "BCM-NAT-TCP"))
+        found = true;
+    rcu_read_unlock();
+    return found;
+}
+
+static int nf_ct_kill_tcp_cone(struct nf_conn *ct, void *data)
+{
+    return nf_ct_is_tcp_cone(ct) ||
+           (ct->master && nf_ct_is_tcp_cone(ct->master));
+}
+
+static DEFINE_MUTEX(nf_ct_nat_tcp_mutex);
+
+static int nf_ct_nat_tcp_sysctl(const struct ctl_table *ctl, int write,
+                               void *buffer, size_t *lenp, loff_t *ppos)
+{
+    struct net *net = container_of(ctl->data, struct net, ct.sysctl_nat_tcp);
+    struct nf_ct_iter_data iter = { .net = net };
+    unsigned int value = READ_ONCE(net->ct.sysctl_nat_tcp);
+    struct ctl_table temporary = *ctl;
+    int ret;
+
+    temporary.data = &value;
+    mutex_lock(&nf_ct_nat_tcp_mutex);
+    ret = proc_douintvec_minmax(&temporary, write, buffer, lenp, ppos);
+    if (!ret && write && value != READ_ONCE(net->ct.sysctl_nat_tcp)) {
+        WRITE_ONCE(net->ct.sysctl_nat_tcp, 0);
+        synchronize_net();
+        nf_ct_iterate_cleanup_net(nf_ct_kill_tcp_cone, &iter);
+        WRITE_ONCE(net->ct.sysctl_nat_tcp, value);
+    }
+    mutex_unlock(&nf_ct_nat_tcp_mutex);
+    return ret;
+}
