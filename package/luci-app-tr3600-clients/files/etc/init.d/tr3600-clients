#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1
start_service() {
    procd_open_instance
    procd_set_param command /bin/sh -c 'while :; do /usr/libexec/tr3600-clients tick; sleep 5; done'
    procd_set_param respawn
    procd_set_param stdout 0
    procd_set_param stderr 1
    procd_close_instance
}
stop_service() {
    nft delete table inet tr3600_clients 2>/dev/null || true
}
